{
  "manifest_version": 3,
  "name": "Sponsor Shield",
  "version": "1.6.0",
  "description": "Mute and blur sponsor segments on YouTube, from SponsorBlock or AI. Choose Show anyway to watch a segment.",
  "minimum_chrome_version": "111",
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://sponsor.ajay.app/*",
    "https://sponsor-shield.spectrumailabs.com/*",
    "https://www.youtube.com/*",
    "https://youtube.com/*"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "action": {
    "default_title": "Sponsor Shield",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/shield-16.png",
      "32": "icons/shield-32.png",
      "48": "icons/shield-48.png",
      "128": "icons/shield-128.png"
    }
  },
  "icons": {
    "16": "icons/shield-16.png",
    "32": "icons/shield-32.png",
    "48": "icons/shield-48.png",
    "128": "icons/shield-128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://youtube.com/*"
      ],
      "js": [
        "transcript-grabber.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://youtube.com/*"
      ],
      "js": [
        "segment-logic.js",
        "refresh-scheduler.js",
        "ai-flow.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
