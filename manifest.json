{
  "manifest_version": 3,
  "name": "YT Sponsor Shield",
  "version": "1.4.0",
  "description": "Mute and blur community-marked sponsor segments on YouTube. Choose Show anyway to watch a segment.",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "https://sponsor.ajay.app/*"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "action": {
    "default_title": "YT Sponsor Shield",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/shield-16.png",
      "32": "icons/shield-32.png",
      "48": "icons/shield-48.png",
      "128": "icons/shield-128.png"
    }
  },
  "icons": {
    "16": "icons/shield-16.png",
    "32": "icons/shield-32.png",
    "48": "icons/shield-48.png",
    "128": "icons/shield-128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://youtube.com/*"
      ],
      "js": [
        "segment-logic.js",
        "refresh-scheduler.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
